# Copier vers /etc/prophunt/prophunt-server.env puis adapter les chemins si nécessaire.
# Ne placer aucun mot de passe, token Steam ou secret dans ce fichier.

PH_SERVER_ROOT=/opt/prophunt/server
PH_MAP=/Game/PropHunt/Tests/L_PH_CaptureTest
PH_GAME_PORT=7777
PH_QUERY_PORT=27015
PH_LOG_DIR=/var/log/prophunt
PH_STATE_DIR=/var/lib/prophunt
PH_STEAM_SDK64_DIR=/opt/steamcmd/linux64
